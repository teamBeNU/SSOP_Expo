{
  "cli": {
    "version": ">= 10.2.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug",
        "env": {
          "JS_ENGINE": "jsc"
        }
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "AWS_S3_AVATAR_URI": "https://ssop-bucket.s3.ap-northeast-2.amazonaws.com/avatar/avt",
        "AWS_S3_AVATAR_THUMBNAIL_URI": "https://ssop-bucket.s3.ap-northeast-2.amazonaws.com/avatar/tmb"
      }
    },
    "production": {
      "distribution": "store"
    }
  },
  "submit": {
    "production": {}
  }
}